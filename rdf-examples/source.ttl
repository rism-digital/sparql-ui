<https://rism.online/sources/212006671/references-notes>
  a rism:ReferencesNotesSection ;
  rism:hasNote
    [
      rdf:value
        "Bestimmung der Schreiberhand nach HornZ 1993; Datierung 1725c-1733c aufgrund der Wirkungszeit des Schreibers."@none ,
        "Die vorliegende Partitur war ursprünglich Teil zweier Sammelbände mit Palestrina-Messen (nämlich die no.10 im Band II), die unter Zelenka angefertigt wurden. Später wurden die einzelnen Mess-Partituren herausgelöst und einzeln verwahrt. Hierzu wie zu weiteren Details der Abschriften von Palestrina-Messen unter Zelenka siehe HornD 1987."@none ,
        "Diese Musikquelle ist Gegenstand des DFG-Projekts „Die Notenbestände der Dresdner Hofkirche und der Königlichen Privat-Musikaliensammlung aus der Zeit der sächsisch-polnischen Union“. Weitere Informationen unter <a href=\"http://hofmusik.slub-dresden.de.\" _target=\"blank\">http://hofmusik.slub-dresden.de.</a>"@none ,
        "Katalogeintrag CatChiesa 1765: <a href=\"http://resolver.staatsbibliothek-berlin.de/SBB0001A38800000082\" _target=\"blank\">http://resolver.staatsbibliothek-berlin.de/SBB0001A38800000082</a>"@none ,
        "Über dem Beginn der Mess-Sätze jeweils Rötelvermerke von Schuberts Hand: \"Kyrie Gloria Credo\", \"Gloria\", \"Credo\"."@none ;
      rdfs:label
        "Nota geral"@pt ,
        "Nota general"@es ,
        "Nota generale"@it ,
        "Bemerkungen"@de ,
        "General note"@en ,
        "Remarque générale"@fr ,
        "Uwaga ogólna"@pl ;
    ] ,
    [
      rdf:value
        "<span>Casimiri, Raffaele Casimiro. 1939-. <i>Giovanni Pierluigi da Palestrina. Le opere complete (33 vol.).</i> Roma.</span> [CasimiriP 1939, vol.1, p.182-210]."@none ,
        "<span>Haberl, Franz Xaver. 1862-1903. <i>Gesamtausgabe der Werke Palestrinas (33 vol.).</i> Leipzig: Breitkopf & Härtel.</span> [HaberlP 1862, vol.10, p.153-174]."@none ,
        "<span>Horn, Wolfgang. 1987. <i>Die Dresdner Hofkirchenmusik um 1720-1745: Studien zu ihren Voraussetzungen und ihrem Repertoire.</i> Kassel: Bärenreiter.</span> [HornD 1987, p.95-99]."@none ,
        "<span>Horn, Wolfgang. Die wichtigsten Schreiber im Umkreis Jan Dismas Zelenkas: Überlegungen zur Methode ihrer Bestimmung und Entwurf einer Gruppierung der Quellen. <i>Zelenka-Studien I</i>, (1993), p.141-210.</span> [HornZ 1993, p.166]."@none ,
        "<span>[No author]. 1765. <i>CATALOGO / [Thematico] / della / Musica di Chiesa.</i> [Dresden]. <a href=\"http://digital.staatsbibliothek-berlin.de/dms/werkansicht/?PPN=PPN828245908\">http://digital.staatsbibliothek-berlin.de/dms/werkansicht/?PPN=PPN828245908</a>.</span> [CatChiesa 1765, Schrank II/P/12/3]."@none ;
      rdfs:label
        "Odniesienie bibliograficzne"@pl ,
        "Riferimenti bibliografici"@it ,
        "Literaturverweis"@de ,
        "Référence bibliographique"@fr ,
        "Bibliographic reference"@en ,
        "Referência bibliográfica"@pt ,
        "Referencia bibliográfica"@es ;
    ] ;
