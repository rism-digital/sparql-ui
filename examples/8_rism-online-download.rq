# Title: List similar to RISM Online download
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX relators: <http://id.loc.gov/vocabulary/relators/>
PREFIX rism: <https://rism.online/api/v1#>

SELECT
    ?url
    ?title
    ?source_type
    ?content_type
    ?record_type
    (GROUP_CONCAT(DISTINCT ?date_statement; separator="; ") AS ?date_statements)
    ?creator_author
    (GROUP_CONCAT(DISTINCT ?other_contrib; separator="; ") AS ?other_contributors)
WHERE {
    ?url a rism:Source .

    OPTIONAL {
      ?url rdfs:label ?title_en .
      FILTER(LANG(?title_en) = "en")
    }
    OPTIONAL {
      ?url rdfs:label ?title_none .
      FILTER(LANG(?title_none) = "none")
    }
    OPTIONAL { ?url rdfs:label ?title_any }
    BIND(COALESCE(?title_en, ?title_none, ?title_any) AS ?title)

    OPTIONAL {
      ?url rism:sourceTypes/rism:recordType ?record_type_node .
      ?record_type_node rdfs:label ?record_type_label .
      FILTER(LANG(?record_type_label) = "en")
    }
    BIND(COALESCE(?record_type_label, IF(EXISTS {
      ?url rism:sourceItems/rism:hasSourceItem ?_part
    }, "Collection", "Item")) AS ?record_type)

    OPTIONAL {
      ?url rism:hasDates/rism:dateStatement ?date_statement .
    }

    OPTIONAL {
      ?url dcterms:creator ?creator .
      ?creator dcterms:relation ?creator_person ;
               rism:hasRole relators:cre .
      ?creator_person rdfs:label ?creator_label .
      FILTER(LANG(?creator_label) = "none")
    }
    BIND(COALESCE(?creator_label, "") AS ?creator_author)

    ?url rism:materialGroups/rism:hasMaterialGroup ?mg .
    ?mg rism:hasSummary ?sumType .
    ?sumType a dcterms:type ;
        rdf:value ?source_type .
    FILTER(LANG(?source_type) = "en")

    OPTIONAL {
      ?url rism:materialGroups/rism:hasMaterialGroup ?mg2 .
      ?mg2 rism:hasSummary ?sumContent .
      ?sumContent rdfs:label ?ctLabel ;
                  rdf:value ?content_type .
      FILTER(LANG(?ctLabel) = "en")
      FILTER(STR(?ctLabel) = "Content type")
      FILTER(LANG(?content_type) = "en")
    }

    {
      BIND(?creator_author AS ?other_contrib)
    }
    UNION
    {
      ?url rism:relationships/rism:hasRelationship ?rel .
      ?rel dcterms:relation ?person .
      ?person rdfs:label ?person_label .
      FILTER(LANG(?person_label) = "none")
      BIND(?person_label AS ?other_contrib)
    }
}
GROUP BY
?url ?title ?source_type ?content_type ?record_type ?creator_author
LIMIT 10000
